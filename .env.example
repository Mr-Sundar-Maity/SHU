# Copy to .env and fill only settings you actually use. Never commit .env.
SHU_AI_PROVIDER=ollama
SHU_CLOUD_FALLBACK=false
SHU_LOCAL_FALLBACK=true
SHU_CLOUD_AI_ENABLED=true
SHU_AUTOMATION_ENABLED=true
SHU_ALLOW_CLOUD_PERSONAL_DATA=false

LOCAL_AI_PROVIDER=ollama
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5:1.5b
GEMINI_API_KEY=
GEMINI_MODEL=

SHU_DATA_DIR=C:\SHU_DATA
SHU_DEFAULT_LANGUAGE=bn
SHU_RESPONSE_STYLE=friendly
SHU_DEFAULT_VOICE=male
SHU_STT_MODEL_SIZE=small
SHU_MICROPHONE_DEVICE=1
SHU_SAMPLE_RATE=16000
SHU_VOICE_BARGE_IN=false
SHU_VOICE_BARGE_IN_RMS=0.03
SHU_REQUEST_TIMEOUT_SECONDS=60
SHU_TTS_TIMEOUT_SECONDS=20
SHU_TTS_RATE_PERCENT=0
SHU_TTS_VOLUME=1.0
SHU_UI_FONT_SIZE=10
SHU_WAKEWORD_MODEL_PATH=
SHU_EMAIL_PROVIDER=none
SHU_GMAIL_OAUTH_CLIENT_SECRETS=C:\SHU_DATA\secrets\gmail-desktop-client.json
SHU_MICROSOFT_OAUTH_CLIENT_ID=
SHU_MICROSOFT_OAUTH_TENANT=common
SHU_WHATSAPP_PHONE_NUMBER_ID=
SHU_WHATSAPP_GRAPH_API_VERSION=v27.0
